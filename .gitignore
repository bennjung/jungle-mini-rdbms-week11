# macOS
.DS_Store

# Dependencies and build output
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local environment variables
.env
.env.*
!.env.example

# Logs
*.log

# Phase 2 generated benchmark data (regenerated by phase2/generate_data.py)
phase2/data/

# Local database state: only the committed seed files are tracked.
# `data/*` (not `data/`) keeps the negations below effective.
# 이미 추적 중인 파일의 수정은 gitignore로 숨길 수 없다.
data/*
!data/registrations.csv
!data/registrations.meta.json
!data/students.csv
!data/students.meta.json
!data/courses.csv
!data/courses.meta.json

